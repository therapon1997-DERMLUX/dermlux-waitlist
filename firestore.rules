rules_version = '2';

// ΚΑΝΟΝΕΣ FIRESTORE DATABASE  (Firebase Console → Firestore Database → Rules)
// ΠΟΤΕ στο Storage → Rules.
//
// Role-based (13/06/2026): οι ευαίσθητες συλλογές κλειδώνονται ανά ρόλο, ώστε
// ένας χακαρισμένος/χαμηλόβαθμος λογαριασμός να ΜΗΝ φτάνει σε όλα.
// Ο worker + η γέφυρα χρησιμοποιούν service account → παρακάμπτουν τους κανόνες.
// Προηγούμενος (ανοιχτός) κανόνας για instant revert: match /{d=**}{ allow read,write: if request.auth!=null }

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function roleOf() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function isAdmin() {
      return authed() && (request.auth.uid == 'TMgFlpv8ZcNGcgk7XKIxjDktf802' || roleOf() == 'admin');
    }
    function isStaff() { return authed() && (isAdmin() || roleOf() == 'agent'); } // κλινικό προσωπικό (όχι ekloges)
    function isMarketer() { return authed() && roleOf() == 'marketer'; } // ΜΟΝΟ email marketing — τίποτα άλλο
    function isAccountant() { return authed() && roleOf() == 'accountant'; } // λογιστής: read-only λογιστικά
    function isExpensesRole() { return authed() && roleOf() == 'expenses'; } // store managers: upload αποδείξεων μόνο

    // ── Χρήστες: ο καθένας βλέπει το δικό του προφίλ· μόνο admin διαχειρίζεται ──
    match /users/{uid} {
      allow read:   if authed() && (request.auth.uid == uid || isAdmin());
      // first-login self-create μόνο ως 'agent' (κανένα privilege escalation)·
      // ο admin μπορεί να δημιουργήσει οποιονδήποτε ρόλο.
      allow create: if isAdmin() || (authed() && request.auth.uid == uid && request.resource.data.role == 'agent');
      allow update, delete: if isAdmin();
    }

    // ── Λογιστικά (07/07/2026): admin πλήρη· λογιστής read-only· store managers
    //    (role 'expenses') μόνο δημιουργία δικών τους αποδείξεων + read τα δικά τους ──
    match /expenses/{d} {
      allow read:   if isAdmin() || isAccountant()
                    || (isExpensesRole() && resource.data.createdByUid == request.auth.uid);
      allow create: if isAdmin()
                    || (isExpensesRole() && request.resource.data.createdByUid == request.auth.uid
                        && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }
    match /bank_transactions/{d}      { allow read: if isAdmin() || isAccountant(); allow write: if isAdmin(); }
    match /extraction_corrections/{d} { allow read, write: if isAdmin(); }

    // ── Μόνο admin (ευαίσθητα: οικονομικά, remote, εκλογικές επαφές) ──
    match /claude_remote_messages/{d} { allow read, write: if isAdmin(); }
    match /claude_remote_state/{d}    { allow read, write: if isAdmin(); }
    match /voteContacts/{d}           { allow read, write: if isAdmin(); }
    match /volunteers/{d}             { allow read, write: if isAdmin(); }

    // ── Email marketing: admin + marketer (ο ρόλος marketer ΔΕΝ φτάνει πουθενά αλλού) ──
    match /email_contacts/{d}         { allow read, write: if isAdmin() || isMarketer(); }
    match /email_campaigns/{d}        { allow read, write: if isAdmin() || isMarketer(); }
    match /email_sends/{d}            { allow read, write: if isAdmin() || isMarketer(); }
    match /email_templates/{d}        { allow read, write: if isAdmin() || isMarketer(); }

    // ── Audit log: append-only, μόνο admin διαβάζει, κανείς δεν σβήνει ──
    match /audit_log/{d} {
      allow create: if authed();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Κλινικά δεδομένα (ασθενείς) — ΜΟΝΟ κλινικό προσωπικό, ΟΧΙ ekloges ──
    match /patients/{d}       { allow read, write: if isStaff(); }
    match /visits/{d}         { allow read, write: if isStaff(); }
    match /consent_forms/{d}  { allow read, write: if isStaff(); }
    match /patient_photos/{d} { allow read, write: if isStaff(); }
    match /clients/{d}        { allow read, write: if isStaff(); }
    match /happyhour/{d}      { allow read, write: if isStaff(); }

    // ── Εκλογές / λοιπά: συνδεδεμένοι χρήστες (admin + ekloges), ΟΧΙ marketer ──
    match /ballot_results/{d}   { allow read, write: if authed() && !isMarketer(); }
    match /eklogika_staff/{d}   { allow read, write: if authed() && !isMarketer(); }
    match /eklogika_matches/{d} { allow read, write: if authed() && !isMarketer(); }

    // ── DEFAULT DENY (20/06/2026): ό,τι δεν επιτράπηκε ΡΗΤΑ πιο πάνω, απορρίπτεται.
    //    Διορθώνει το παλιό catch-all `if authed()` που λόγω OR-semantics της Firestore
    //    έδινε σε ΚΑΘΕ συνδεδεμένο χρήστη (agent/ekloges) πρόσβαση στα «admin-only»
    //    (expenses, email_contacts κ.λπ.). Τώρα μόνο οι ρητοί κανόνες δίνουν πρόσβαση.
    //    Instant revert αν χρειαστεί: match /{document=**}{ allow read,write: if authed() && !isMarketer() }
    match /{document=**} { allow read, write: if false; }
  }
}
